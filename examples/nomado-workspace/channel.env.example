# Номадо · агент маркетплейсов · channel.env
#
# Копируется в /etc/dashi-plugin/nomado-market/channel.env
# chmod 640, chown root:agentctl. Реальные значения в git не коммитить.

# ─── Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<токен от @BotFather>
TELEGRAM_EXPECTED_BOT_ID=<числовая часть токена до ":">
TELEGRAM_ALLOWED_USER_IDS=<ваш user_id от @userinfobot>
TELEGRAM_ALLOWED_CHAT_IDS=<тот же id, либо -100... для группы>

# ─── Workspace ───────────────────────────────────────────────────
TELEGRAM_WORKSPACE_ROOT=/home/agentctl/.claude-lab/nomado-market/.claude
AGENT_ID=nomado-market
TELEGRAM_STATE_DIR=/home/agentctl/.claude-lab/shared/state/nomado-market/telegram

# ─── Webhook (локальный, для Claude hooks) ───────────────────────
# Порт должен отличаться от других агентов на этой машине.
# travel-агент, если он ещё жив, обычно на 8089 — берём следующий.
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8091

# ─── Память ──────────────────────────────────────────────────────
TELEGRAM_MEMORY_ENABLED=true
TELEGRAM_MEMORY_WORKSPACE=/home/agentctl/.claude-lab/nomado-market/.claude
TELEGRAM_MEMORY_AGENT_LABEL=NomadoMarket
TELEGRAM_MEMORY_SOURCE_TAG=tg

# ─── Seller API (этап 3, до этого не нужны) ──────────────────────
# WB_SELLER_API_TOKEN=
# OZON_CLIENT_ID=
# OZON_API_KEY=
