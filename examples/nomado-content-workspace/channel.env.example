# Номадо · агент контента и визуала · channel.env
#
# Копируется в /etc/dashi-plugin/nomado-content/channel.env
# chmod 640, chown root:agentctl. Реальные значения в git не коммитить.

TELEGRAM_BOT_TOKEN=<токен от @BotFather — отдельный бот, не тот же что у market>
TELEGRAM_EXPECTED_BOT_ID=<числовая часть токена до ":">
TELEGRAM_ALLOWED_USER_IDS=<ваш user_id от @userinfobot>
TELEGRAM_ALLOWED_CHAT_IDS=<тот же id, либо -100... для группы>

TELEGRAM_WORKSPACE_ROOT=/home/agentctl/.claude-lab/nomado-content/.claude
AGENT_ID=nomado-content
TELEGRAM_STATE_DIR=/home/agentctl/.claude-lab/shared/state/nomado-content/telegram

# Порт отличается от nomado-market (8091) и travel-агента (8089)
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8092

TELEGRAM_MEMORY_ENABLED=true
TELEGRAM_MEMORY_WORKSPACE=/home/agentctl/.claude-lab/nomado-content/.claude
TELEGRAM_MEMORY_AGENT_LABEL=NomadoContent
TELEGRAM_MEMORY_SOURCE_TAG=tg
